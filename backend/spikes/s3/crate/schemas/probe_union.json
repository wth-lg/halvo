{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "choice": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "count"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            }
          },
          "required": [
            "type",
            "count"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unit"
            },
            "unit": {
              "type": "string",
              "enum": [
                "day",
                "week"
              ]
            }
          },
          "required": [
            "type",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "note": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "a",
            "b"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "enum": [
              "x",
              "y"
            ]
          }
        },
        "required": [
          "sku"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "choice",
    "note",
    "items"
  ],
  "additionalProperties": false,
  "title": "Request"
}

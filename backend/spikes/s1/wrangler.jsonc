{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "halvo-s1-ledger",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  "durable_objects": {
    "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ledger"] }]
}

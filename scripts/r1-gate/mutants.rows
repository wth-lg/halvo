required-kinds-weakened	lib.sh	s/for required in screen_frame keystroke pointer foreground_app window_title; do/for required in keystroke; do/	test selftest:timed-run/pointer-zero	required	RR-gate-ci-21
missing-line-accepted	lib.sh	s/\[ "\$count" = 0 \]/[ "\${count:-0}" = 0 ]/	test selftest:secure-input/line-absent	required	RR-gate-ci-21
cost-sampler-constant	lib.sh	s/printf "%\.2f\\n", \(\$3 \+ \$5\) \/ \$1 \* 100/printf "0.00\\n"/	test selftest:cost/standin-short-lived-threads	required	X-gate-ci-09
memory-sampler-constant	lib.sh	s/printf "%d %d %d %d %d %d\\n", peak, mean, n, a, b, c/printf "0 0 1 0 0 0\\n"/	test selftest:memory/standin-spike-munmap	required	X-gate-ci-09
bound-reader-constant	lib.sh	s/gate_bound\(\) \{\n.*?\n\}\n/gate_bound() {\n  printf "999999999999\\n"\n}\n/s	test selftest:memory/bound-key-missing	required	X-gate-ci-09
mutant-does-not-compile	crates/halvo-capture/src/lib.rs	s/\z/\nconst GATE_CONTROL: u8 = "a control that must not build";\n/	measured segment_roundtrip	control	RR-gate-ci-02
m3-active-tap	crates/halvo-capture/src/macos/input.rs	s/CGEventTapOptions::ListenOnly/CGEventTapOptions::Default/	measured active-tap	transitional	B15-04
lease-control-skipped	lib.sh	s/(lease_control\(\) \{\n)/$1  return 0\n/	test selftest:service-run/standin-lease-ignored	required	B15-14
foreground-count-weakened	lib.sh	s/\[ "\$1" -ge 2 \] && return 0/[ "\$1" -ge 1 ] && return 0/	test selftest:timed-run/foreground-count-1	required	RR-gate-ci-01
marker-scan-skips-a-missing-capture	lib.sh	s/    \[ -f "\$scan_file" \] \|\| \{ printf [^\n]*\n/    [ -f "\$scan_file" ] || continue\n/; s/    missing\) printf [^\n]*\n/    missing) return 0 ;;\n/	test selftest:service-run/marker-scan-misses-a-capture-file	required	X-gate-ci-08

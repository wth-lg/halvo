index 317869c5..01554252 100644
--- a/crates/halvo-control/src/service.rs
+++ b/crates/halvo-control/src/service.rs
@@ -1122,4 +1122,19 @@ mod start_value_registry_tests {
             );
         }
     }
+
+    #[test]
+    fn adversary3_a_start_value_of_another_type_is_replaced() {
+        let scratch = ScratchKey(format!(r"Software\Halvo-Test-A3-{}", std::process::id()));
+        let spec = StartValueSpec::with_key(&scratch.0, RUN_VALUE_NAME, Path::new(r"C:\Halvo\halvo.exe")).unwrap();
+        let status = std::process::Command::new("reg")
+            .args(["add", &format!(r"HKCU\{}", scratch.0), "/v", RUN_VALUE_NAME, "/t", "REG_DWORD", "/d", "1", "/f"])
+            .status()
+            .unwrap();
+        assert!(status.success());
+        let written = write_start_value(&spec);
+        println!("OBSERVED write={written:?}");
+        assert_eq!(written.unwrap(), InstallOutcome::Written);
+        assert_eq!(read_start_value(&spec).unwrap(), Some(spec.data()));
+    }
 }
